0>0.000000</R10><R11>1.000000</R11><R12>0.000000</R12><R20>0.000000</R20><R21>0.000000</R21><R22>1.000000</R22></CoordinateFrame><token name="EasingDirection">2</token><token name="EasingStyle">3</token><string name="Name">HumanoidRootPart</string><float name="Weight">0</float></Properties><Item class="Pose" referent="RBX0000C3"><Properties><CoordinateFrame name="CFrame"><X>0.000000</X><Y>0.000000</Y><Z>0.000000</Z><R00>1.000000</R00><R01>0.000000</R01><R02>0.000000</R02><R10>0.000000</R10><R11>1.000000</R11><R12>0.000000</R12><R20>0.000000</R20><R21>0.000000</R21><R22>1.000000</R22></CoordinateFrame><token name="EasingDirection">2</token><token name="EasingStyle">3</token><string name="Name">LowerTorso</string><float name="Weight">0</float></Properties><Item class="Pose" referent="RBX0000C2"><Properties><CoordinateFrame name="CFrame"><X>0.000000</X><Y>0.000000</Y><Z>0.000000</Z><R00>1.000000</R00><R01>0.000000</R01><R02>0.000000</R02><R10>0.000000</R10><R11>1.000000</R11><R12>0.000000</R12><R20>0.000000</R20><R21>0.000000</R21><R22>1.000000</R22></CoordinateFrame><token name="EasingDirection">2</token><token name="EasingStyle">3</token><string name="Name">UpperTorso</string><float name="Weight">0</float></Properties><Item class="Pose" referent="RBX0000C1"><Properties><CoordinateFrame name="CFrame"><X>0.000000</X><Y>0.000000</Y><Z>0.000000</Z><R00>0.864598</R00><R01>-0.412763</R01><R02>0.286525</R02><R10>0.303447</R10><R11>-0.025576</R11><R12>-0.952505</R12><R20>0.400487</R20><R21>0.910479</R21><R22>0.103139</R22></CoordinateFrame><token name="EasingDirection">2</token><token name="EasingStyle">3</token><string name="Name">LeftUpperArm</string><float name="Weight">1</float></Properties><Item class="Pose" referent="RBX0000C0"><Properties><CoordinateFrame name="CFrame"><X>0.000000</X><Y>0.000000</Y><Z>0.000000</Z><R00>1.000000</R00><R01>0.000000</R01><R02>0.000000</R02><R10>0.000000</R10><R11>0.999739</R11><R12>-0.022862</R12><R20>0.000000</R20><R21>0.022862</R21><R22>0.999739</R22></CoordinateFrame><token name="EasingDirection">2</token><token name="EasingStyle">3</token><string name="Name">LeftLowerArm</string><float name="Weight">1</float></Properties><Item class="Pose" referent="RBX0000BF"><Properties><CoordinateFrame name="CFrame"><X>0.000000</X><Y>0.000000</Y><Z>0.000000</Z><R00>0.936215</R00><R01>0.348733</R01><R02>-0.043445</R02><R10>-0.351424</R10><R11>0.928356</R11><R12>-0.121062</R12><R20>-0.001886</R20><R21>0.128608</R21><R22>0.991694</R22></CoordinateFrame><token name="EasingDirection">2</token><token name="EasingStyle">3</token><string name="Name">LeftHand</string><float name="Weight">1</float></Properties></Item></Item></Item></Item></Item></Item></Item></Item></Item><Item class="Script" referent="RBX0000C5"><Properties><string name="Name">LeafBowDualEquip</string><bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[-- LeafBowDualEquip  (Script → StarterPlayer > StarterCharacterScripts)
-- "Dual Bows" mythic: clones ReplicatedStorage.LeafBow twice and welds one to each hand.
-- Enable by setting the character attribute DualBows = true (e.g. when the upgrade card is picked).
-- Works alongside LeafBowEquip: while DualBows is true the single bow is hidden.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local BOW_HEIGHT = 4.219889
local MODEL_HEIGHT = 1.110497
local GRIP_CENTER = Vector3.new(0.000000, 0.000937, 0.000404)

local character = script.Parent
local S = BOW_HEIGHT / MODEL_HEIGHT

local function makeBow(name, handName)
	local hand = character:WaitForChild(handName)
	local bow = ReplicatedStorage:WaitForChild("LeafBow"):Clone()
	bow.Name = name
	bow:ScaleTo(bow:GetScale() * BOW_HEIGHT / bow:GetExtentsSize().Y)
	local grip = bow:FindFirstChild("Grip", true)
	for _, p in bow:GetDescendants() do
		if p:IsA("BasePart") then
			p.Anchored = false
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
			p.Massless = true
			if p ~= grip then
				local wc = Instance.new("WeldConstraint")
				wc.Part0 = grip
				wc.Part1 = p
				wc.Parent = p
			end
		end
	end
	local origin = Instance.new("Attachment")
	origin.Name = "BowOrigin"
	origin.CFrame = CFrame.new(-GRIP_CENTER * S)
	origin.Parent = grip
	bow:SetAttribute("StudsPerUnit", S)
	local weld = Instance.new("Weld")
	weld.Name = "BowGrip"
	weld.Part0 = hand
	weld.Part1 = grip
	weld.C0 = CFrame.new(0, -0.15, 0) * CFrame.Angles(-math.pi / 2, 0, 0)
	weld.C1 = CFrame.new(-GRIP_CENTER * S)
	weld.Parent = grip
	bow.Parent = character
	return bow
end

local bows = nil
local function setVisible(model, on)
	if not model then return end
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") then p.LocalTransparencyModifier = on and 0 or 1 p.Transparency = on and 0 or 1 end
	end
end
local function apply()
	local on = character:GetAttribute("DualBows") == true
	if on and not bows then
		bows = { makeBow("LeafBow_L", "LeftHand"), makeBow("LeafBow_R", "RightHand") }
	elseif not on and bows then
		for _, b in bows do b:Destroy() end
		bows = nil
	end
	setVisible(character:FindFirstChild("LeafBow"), not on)
end
character:GetAttributeChangedSignal("DualBows"):Connect(apply)
apply()
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX0000C6"><Properties><string name="Name">LeafBowDualAnimator</string><bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[-- LeafBowDualAnimator  (LocalScript → StarterPlayer > StarterCharacterScripts)
-- Dual Bows mythic: twin aim, alternating right/left shots at double the single-bow rate.
-- Bowstrings draw themselves (magic draw) between shots; arrows launch at each "Release" marker.
-- Disable LeafBowAnimator while the DualBows attribute is true (it checks the same attribute).
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ContextActionService = game:GetService("ContextActionService")

local ANIM_IDS = { Hold = "", Raise = "", Aim = "", Fire_R = "", Fire_L = "" }
local AUTO_FIRE = true
local SINGLE_BOW_INTERVAL = 0.6     -- seconds between shots with one bow; dual fires every half of this
local SPEED = 1.0                   -- attack-speed multiplier (other upgrades)
local ARROW_SPEED = 90
local ARROW_RANGE = 80
local REDRAW_TIME = 0.16            -- magic redraw after each shot
local DRAW = 0.8                    -- how far the string pulls back (0..1, 1 = full single-bow draw)
local function hasTarget() return true end
local function onShot(origin: Vector3, direction: Vector3, hand: string)
	-- Fire a RemoteEvent here so the server can raycast and apply damage.
end

local ANCHOR_TOP = Vector3.new(0.000000, 0.407010, 0.168536)
local ANCHOR_BOTTOM = Vector3.new(0.000000, -0.400056, 0.170144)
local REST_NOCK = Vector3.new(-0.045000, 0.108000, 0.169132)
local ARROW_REST = Vector3.new(-0.045000, 0.108000, -0.050000)
local ARROW_LENGTH = 0.864000

local character = script.Parent
local humanoid = character:WaitForChild("Humanoid")
local animator = humanoid:WaitForChild("Animator")

local folder = ReplicatedStorage:FindFirstChild("LeafBowDualAnimations")
local function loadTrack(name)
	local id = ANIM_IDS[name]
	if id == "" then
		local kfs = folder and folder:FindFirstChild("DualBow_" .. name)
		assert(kfs, "No animation id or KeyframeSequence for " .. name)
		id = game:GetService("KeyframeSequenceProvider"):RegisterKeyframeSequence(kfs)
	end
	local anim = Instance.new("Animation")
	anim.AnimationId = id
	return animator:LoadAnimation(anim)
end
local tracks = {}
for _, n in { "Hold", "Raise", "Aim", "Fire_R", "Fire_L" } do tracks[n] = loadTrack(n) end
tracks.Hold.Priority, tracks.Hold.Looped = Enum.AnimationPriority.Action, true
tracks.Raise.Priority = Enum.AnimationPriority.Action2
tracks.Aim.Priority, tracks.Aim.Looped = Enum.AnimationPriority.Action2, true
tracks.Fire_R.Priority, tracks.Fire_L.Priority = Enum.AnimationPriority.Action3, Enum.AnimationPriority.Action3

local arrowTemplate = ReplicatedStorage:WaitForChild("LeafArrow")
local function newString()
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Cylinder
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
	p.Material = Enum.Material.SmoothPlastic
	p.Color = Color3.fromRGB(236, 226, 199)
	p.Parent = workspace.CurrentCamera
	return p
end

-- per-bow state
local rigs = {}
local function buildRig(side)
	local bow = character:WaitForChild(side == "R" and "LeafBow_R" or "LeafBow_L", 5)
	if not bow then return nil end
	local grip = bow:FindFirstChild("Grip", true)
	for _, n in { "String_Upper", "String_Lower" } do local p = bow:FindFirstChild(n, true) if p then p.Transparency = 1 end end
	local S = bow:GetAttribute("StudsPerUnit")
	local arrow = arrowTemplate:Clone()
	for _, p in arrow:GetDescendants() do if p:IsA("BasePart") then p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false end end
	arrow:ScaleTo(arrow:GetScale() * (ARROW_LENGTH * S) / arrow:GetExtentsSize().Z)
	arrow.WorldPivot = (arrow:GetBoundingBox())
	return { side = side, origin = grip:WaitForChild("BowOrigin"), S = S, up = newString(), lo = newString(), arrow = arrow, half = arrow:GetExtentsSize().Z / 2, d = 0, releasedAt = -1 }
end

local function launch(r)
	local o = r.origin.WorldCFrame
	local nock = o * (Vector3.new(REST_NOCK.X, REST_NOCK.Y, REST_NOCK.Z + 0.3 * r.d) * r.S)
	local a = r.arrow:Clone()
	a:PivotTo(CFrame.lookAt(nock, nock + o.LookVector) * CFrame.new(0, 0, -r.half))
	a.Parent = workspace
	onShot(nock, o.LookVector, r.side)
	r.d, r.releasedAt = 0, os.clock()
	local dist, conn = 0, nil
	conn = RunService.Heartbeat:Connect(function(dt)
		local step = ARROW_SPEED * dt
		dist += step
		a:PivotTo(a:GetPivot() + o.LookVector * step)
		if dist >= ARROW_RANGE then conn:Disconnect() a:Destroy() end
	end)
end

local active, aiming, nextSide, nextShot = false, false, "R", 0
tracks.Fire_R:GetMarkerReachedSignal("Release"):Connect(function() if rigs.R then launch(rigs.R) end end)
tracks.Fire_L:GetMarkerReachedSignal("Release"):Connect(function() if rigs.L then launch(rigs.L) end end)

local function startAim()
	if aiming then return end
	aiming = true
	tracks.Raise:Play(0.08)
	task.delay(tracks.Raise.Length > 0 and tracks.Raise.Length or 0.18, function() if aiming then tracks.Aim:Play(0.05) end end)
	nextShot = os.clock() + 0.2
end
local function stopAim()
	if not aiming then return end
	aiming = false
	tracks.Aim:Stop(0.2)
	tracks.Raise:Stop(0.1)
end
local function shoot()
	local interval = SINGLE_BOW_INTERVAL / 2 / SPEED
	if os.clock() < nextShot then return end
	local tr = tracks["Fire_" .. nextSide]
	tr:Play(0.02, 1, math.max(1, 0.24 / interval))
	nextSide = nextSide == "R" and "L" or "R"
	nextShot = os.clock() + interval
end

local held = false
if not AUTO_FIRE then
	ContextActionService:BindAction("LeafBowDualShoot", function(_, st)
		held = st == Enum.UserInputState.Begin
		return Enum.ContextActionResult.Pass
	end, true, Enum.UserInputType.MouseButton1, Enum.KeyCode.ButtonR2)
end

local function segment(part, a, b, thick)
	part.Size = Vector3.new((b - a).Magnitude, thick, thick)
	part.CFrame = CFrame.lookAt((a + b) / 2, b) * CFrame.Angles(0, math.pi / 2, 0)
end

local function setActive(on)
	if on == active then return end
	active = on
	if on then
		rigs.R, rigs.L = buildRig("R"), buildRig("L")
		tracks.Hold:Play(0.2)
	else
		stopAim()
		tracks.Hold:Stop(0.2)
		for _, r in rigs do r.up:Destroy() r.lo:Destroy() r.arrow:Destroy() end
		rigs = {}
	end
end
character:GetAttributeChangedSignal("DualBows"):Connect(function() setActive(character:GetAttribute("DualBows") == true) end)
setActive(character:GetAttribute("DualBows") == true)

RunService.RenderStepped:Connect(function(dt)
	if not active then return end
	local want = AUTO_FIRE and (humanoid.MoveDirection.Magnitude < 0.05 and hasTarget()) or (not AUTO_FIRE and held)
	if want then startAim() if aiming and tracks.Aim.IsPlaying then shoot() end else stopAim() end
	for _, r in rigs do
		if aiming then r.d = math.min(DRAW, r.d + dt * DRAW / REDRAW_TIME) else r.d = math.max(0, r.d - dt * 4) end
		local o = r.origin.WorldCFrame
		local t = os.clock() - r.releasedAt
		local wobble = (r.releasedAt > 0 and t < 0.5) and -0.2 * math.exp(-t * 9) * math.sin(t * 55) or 0
		local nock = o * (Vector3.new(REST_NOCK.X, REST_NOCK.Y, REST_NOCK.Z + 0.3 * (r.d + wobble)) * r.S)
		local thick = math.max(0.03, 0.0056 * r.S)
		segment(r.up, o * (ANCHOR_TOP * r.S), nock, thick)
		segment(r.lo, o * (ANCHOR_BOTTOM * r.S), nock, thick)
		if aiming and r.d > 0.25 then
			r.arrow.Parent = workspace.CurrentCamera
			r.arrow:PivotTo(CFrame.lookAt(nock, o * (ARROW_REST * r.S)) * CFrame.new(0, 0, -r.half))
		else
			r.arrow.Parent = nil
		end
	end
end)
]]></ProtectedString></Properties></Item></Item></roblox>