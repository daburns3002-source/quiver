--!strict
--[[
	Plays a Claude Design model's own clips (`Config/ModelClips/<Model>`,
	generated by tools/glb_clips_to_luau.py) on the model the owner imported.
	Roblox's importer does not bring clips for these models (they have no
	skin: each part rides a joint node), so the clips travel as data and are
	played here.

	Data-driven: any Model tagged `ModelClips` (CollectionService) is
	animated on this client with the data module its `ModelClips` attribute
	names, playing the clip named by its `ModelClip` attribute (none, or an
	unknown name, holds it at rest). Changing the attribute switches the
	clip; the server can set it and it replicates. `ModelClipSpeed` scales
	the clip's pace.

	For a model the server times (a boss's beats): `ModelClipAt` is the
	server time (`workspace:GetServerTimeNow()`) the clip started, so every
	client is on the same frame of it however late the attribute arrived,
	and `ModelClipSpan` the seconds it is to last, which sets its pace.
	A clip the data marks `loops = false` plays once and holds its last
	frame. `ModelClipStretch` (a Vector3) scales the joint named by
	`ModelClipStretchJoint` on top of the clip, and the inverse is put back
	on the joints `ModelClipStretchKeep` lists (comma separated), so a
	chain stretches to its lane and the fist at its end does not.

	A part welded to the model (an enemy's skin, welded to its hitbox so
	it still follows the server where no client animates it) is unwelded on
	this client while it is animated. A part whose `RestSize` attribute is
	set rests smaller than Roblox's smallest part (a lash link tucked away
	at a thousandth of its size): clips scale that size, not the clamped
	one. A part whose `RestCFrame` attribute is set rests there relative to
	the model's pivot, wherever it stands when the animator starts.

	Presentation only. The model's parts are moved relative to its pivot each
	frame, so the model can be moved by anything else as usual. How the
	import scaled and turned the model is read from its parts' rest places
	(`ModelClip.fit`), never assumed.
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Log = require(ReplicatedStorage.Shared.Util.Log)
local ModelClip = require(ReplicatedStorage.Shared.Util.ModelClip)

local log = Log.forTag("ModelAnimator")

local ModelAnimator = {}

--[[ Models are found by this tag; the attribute of the same name says
     which data module they use. ]]
local TAG = "ModelClips"
local KEY_ATTRIBUTE = "ModelClips"
local CLIP_ATTRIBUTE = "ModelClip"
local SPEED_ATTRIBUTE = "ModelClipSpeed"
local AT_ATTRIBUTE = "ModelClipAt"
local SPAN_ATTRIBUTE = "ModelClipSpan"
local STRETCH_ATTRIBUTE = "ModelClipStretch"
local STRETCH_JOINT_ATTRIBUTE = "ModelClipStretchJoint"
local STRETCH_KEEP_ATTRIBUTE = "ModelClipStretchKeep"
local REST_SIZE_ATTRIBUTE = "RestSize"
local REST_CFRAME_ATTRIBUTE = "RestCFrame"
--[[ A fit whose parts sit further than this share of the model's spread
     from where the data puts them means the parts do not belong to this
     data: the model is left alone rather than scrambled. ]]
local MAX_FIT_ERROR = 0.2
--[[ A part's size is only rewritten when a joint scale moved it this much. ]]
local SIZE_EPSILON = 1e-3

type Driven = {
	part: BasePart,
	joint: string,
	rest: CFrame,
	size: Vector3,
	welds: { WeldConstraint },
	anchored: boolean,
}
type Animator = {
	model: Model,
	data: ModelClip.Model,
	fit: ModelClip.Fit,
	restInverse: { [string]: ModelClip.Affine },
	driven: { Driven },
	pivotRest: CFrame,
	time: number,
	--[[ Where a part rests in the pivot's space (see `attach`). ]]
	restOf: (BasePart) -> CFrame,
}

local animators: { [Model]: Animator } = {}
local folder: Instance? = nil

--[[ Starts moving `part` with its joint: unwelded and anchored for as long
     as it is animated. ]]
local function drive(a: Animator, part: BasePart)
	local welds: { WeldConstraint } = {}
	for _, child in part:GetChildren() do
		if child:IsA("WeldConstraint") and child.Enabled then
			child.Enabled = false
			table.insert(welds, child)
		end
	end
	local restSize = part:GetAttribute(REST_SIZE_ATTRIBUTE)
	table.insert(a.driven, {
		part = part,
		joint = a.data.parts[part.Name].joint,
		rest = a.restOf(part),
		size = if typeof(restSize) == "Vector3" then restSize else part.Size,
		welds = welds,
		anchored = part.Anchored,
	})
	part.Anchored = true
end

local function dataFor(key: string): ModelClip.Model?
	local clips = folder or ReplicatedStorage.Shared.Config:FindFirstChild("ModelClips")
	folder = clips
	local module = clips and clips:FindFirstChild(key)
	if not module or not module:IsA("ModuleScript") then
		return nil
	end
	return (require :: any)(module) :: ModelClip.Model
end

--[[ Starts animating `model` with the data module `key`. Returns false when
     the data is missing or the model's parts do not match it. ]]
function ModelAnimator.attach(model: Model, key: string): boolean
	if animators[model] then
		return true
	end
	local data = dataFor(key)
	if not data then
		log.warn(`no ModelClips data named {key} for {model:GetFullName()}`)
		return false
	end
	local pivot = model:GetPivot()
	-- a node with several primitives imports as several parts of its name:
	-- all ride its joint, but none of them is the node's whole box, so the
	-- fit reads the import from the names that came in once
	local parts: { BasePart } = {}
	local count: { [string]: number } = {}
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and data.parts[d.Name] then
			table.insert(parts, d)
			count[d.Name] = (count[d.Name] or 0) + 1
		end
	end
	--[[ Where each part rests in the pivot's space: its `RestCFrame` when
	     the builder gave one (an enemy's skin: a welded part lags its moving
	     hitbox by a frame on a client, which read as a bad fit and left the
	     King unanimated), else where it stands now. ]]
	local function restOf(part: BasePart): CFrame
		local given = part:GetAttribute(REST_CFRAME_ATTRIBUTE)
		return if typeof(given) == "CFrame" then given else pivot:ToObjectSpace(part.CFrame)
	end
	local observed: { [string]: { position: Vector3, size: Vector3 } } = {}
	for _, part in parts do
		if count[part.Name] == 1 then
			observed[part.Name] = { position = restOf(part).Position, size = part.Size }
		end
	end
	local fit = ModelClip.fit(data, observed)
	if not fit or fit.error > MAX_FIT_ERROR * fit.spread then
		log.warn(
			`{model:GetFullName()}'s parts do not line up with {key} (fit error {fit and fit.error})`
		)
		return false
	end
	local a: Animator = {
		model = model,
		data = data,
		fit = fit,
		restInverse = ModelClip.restInverse(data),
		driven = {},
		pivotRest = pivot,
		time = 0,
		restOf = restOf,
	}
	for _, part in parts do
		drive(a, part)
	end
	animators[model] = a
	return true
end

function ModelAnimator.detach(model: Model)
	local a = animators[model]
	if not a then
		return
	end
	animators[model] = nil
	local pivot = model:GetPivot()
	for _, d in a.driven do
		d.part.CFrame = pivot * d.rest
		d.part.Size = d.size
		d.part.Anchored = d.anchored
		for _, weld in d.welds do
			weld.Enabled = true
		end
	end
end

--[[ The joints a model's stretch attributes scale, or nil for none. ]]
local function stretchOf(model: Model): ModelClip.Stretch?
	local amount = model:GetAttribute(STRETCH_ATTRIBUTE)
	local joint = model:GetAttribute(STRETCH_JOINT_ATTRIBUTE)
	if typeof(amount) ~= "Vector3" or type(joint) ~= "string" or amount == Vector3.one then
		return nil
	end
	local out: ModelClip.Stretch = { [joint] = amount }
	local keep = model:GetAttribute(STRETCH_KEEP_ATTRIBUTE)
	if type(keep) == "string" then
		local inverse = Vector3.new(
			1 / math.max(amount.X, 1e-3),
			1 / math.max(amount.Y, 1e-3),
			1 / math.max(amount.Z, 1e-3)
		)
		for name in string.gmatch(keep, "[^,%s]+") do
			out[name] = inverse
		end
	end
	return out
end

--[[ Poses `model` `time` seconds into its current clip. Exposed so a probe
     or a test can pose a model at a chosen moment. ]]
function ModelAnimator.pose(model: Model, time: number)
	local a = animators[model]
	if not a then
		return
	end
	local name = model:GetAttribute(CLIP_ATTRIBUTE)
	local clip = if type(name) == "string" then a.data.clips[name] else nil
	local deltas = ModelClip.deltas(a.data, clip, time, a.restInverse, stretchOf(model))
	local pivot = model:GetPivot()
	for _, d in a.driven do
		local delta = deltas[d.joint]
		if delta then
			local cframe, stretch = ModelClip.place(d.rest, delta, a.fit)
			d.part.CFrame = pivot * cframe
			local size = d.size * stretch
			if (size - d.part.Size).Magnitude > SIZE_EPSILON then
				d.part.Size = size
			end
		end
	end
end

local function step(dt: number)
	for model, a in animators do
		if not model.Parent then
			animators[model] = nil
			continue
		end
		local speed = model:GetAttribute(SPEED_ATTRIBUTE)
		local pace = if type(speed) == "number" then speed else 1
		local span = model:GetAttribute(SPAN_ATTRIBUTE)
		local name = model:GetAttribute(CLIP_ATTRIBUTE)
		local clip = if type(name) == "string" then a.data.clips[name] else nil
		if type(span) == "number" and span > 0 and clip then
			pace *= clip.length / span
		end
		local at = model:GetAttribute(AT_ATTRIBUTE)
		if type(at) == "number" then
			a.time = math.max(0, Workspace:GetServerTimeNow() - at) * pace
		else
			a.time += dt * pace
		end
		ModelAnimator.pose(model, a.time)
	end
end

local function watch(model: Instance)
	if not model:IsA("Model") then
		return
	end
	local function check()
		local key = model:GetAttribute(KEY_ATTRIBUTE)
		if type(key) == "string" and key ~= "" then
			ModelAnimator.attach(model, key)
		else
			ModelAnimator.detach(model)
		end
	end
	model:GetAttributeChangedSignal(KEY_ATTRIBUTE):Connect(check)
	--[[ A big model reaches a client over several frames, and the tag can
	     come first: King Bloblin's lash chain arrived after he was attached,
	     was never driven, and stayed a heap of thousandth-size cubes. Any
	     part of the model that arrives later joins in. ]]
	model.DescendantAdded:Connect(function(added)
		local a = animators[model]
		if not (a and added:IsA("BasePart") and a.data.parts[added.Name]) then
			return
		end
		for _, d in a.driven do
			if d.part == added then
				return
			end
		end
		drive(a, added)
	end)
	model:GetAttributeChangedSignal(CLIP_ATTRIBUTE):Connect(function()
		local a = animators[model]
		if a then
			a.time = 0
		end
	end)
	check()
end

function ModelAnimator.start()
	for _, model in CollectionService:GetTagged(TAG) do
		watch(model)
	end
	CollectionService:GetInstanceAddedSignal(TAG):Connect(watch)
	CollectionService:GetInstanceRemovedSignal(TAG):Connect(function(model)
		if model:IsA("Model") then
			ModelAnimator.detach(model)
		end
	end)
	RunService.RenderStepped:Connect(step)
end

return ModelAnimator
