--!strict
--[[
	Rigged enemies' skinned bodies. Each entry is generated by that
	enemy's own `assets/models/enemies/<name>/rig_to_luau.py` from the
	owner's handoff; regenerate, never hand-edit.

	An enemy's skinned body: the mesh part named `part` carries `bones`
	(rest CFrames at the import's size, parents first), and the game's
	body is `scale` of that size. `clips` are its animations as each
	bone's Transform per key (x, y, z, qx, qy, qz, qw), played Linear by
	`Fx/EnemyRig`; `strideSpeed` is the studs a second Run is drawn at,
	at the import's size.
]]

export type Bone = { name: string, parent: string, cframe: { number } }
export type Clip = {
	length: number,
	loop: boolean,
	markers: { [string]: number },
	times: { number },
	bones: { [string]: { { number } } },
}
export type Rig = {
	part: string,
	scale: number,
	strideSpeed: number,
	bones: { Bone },
	clips: { [string]: Clip },
}

--[[ No rigged enemy in the game right now. The Ember Wilf was the only
     one, and the owner took it out for good (2026-11-01: "take the ember
     wilf out all the way"); everything that reads this file --
     `Fx/EnemyRig`, `Enemies/EnemyModel`, `Util/RigClip` -- is kept, because
     it is general and the next skinned enemy drops straight into it.

     Add one by running `assets/models/enemies/<name>/rig_to_luau.py` and
     pasting its table here, then naming it in that enemy's
     `Config/EnemyDesigns` entry as `rig`. ]]
local EnemyRigs: { [string]: Rig } = {}

return table.freeze(EnemyRigs)
