--!strict
--[[
	Every area's outer forest merged into a few chunks (docs/PERFORMANCE.md,
	option 2, owner 2026-11-27): about ten draws a room instead of one per
	tree. Generated by tools/forest_chunks.py from each forest's layout
	(`Config/GladeForest` and the rest, which stay the record of every
	part) and the chunks' uploaded mesh ids; regenerate, never hand-edit.

	`parts` are ArenaModels.ArenaPart, drawn as every outer part is;
	`crowns` are the trees' crowns the scenery's life settles on
	(`Fx/ForestAmbience`), which the merged meshes no longer name:
	each a crown's centre, its narrower side and the height of its top.
]]

type Part = {
	name: string,
	meshId: string,
	size: Vector3,
	offset: Vector3,
	glow: boolean?,
	matte: boolean?,
	tint: Color3?,
	-- Unused here, but in ArenaModels.ArenaPart, which this must match.
	water: Color3?,
	bank: Color3?,
}

export type Crown = { x: number, z: number, reach: number, top: number }

export type Forest = { parts: { Part }, crowns: { Crown } }

